+package gg.roll.viewmodel.core
+
+import com.latenighthack.ktbuf.test.server.runTestWithServer
+import gg.roll.fullhouse.server.attachTestServices
+import gg.roll.viewmodel.core.tools.runCoreTest
+import io.ktor.server.application.Application
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.async
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withTimeout
+import kotlin.test.Test
+import kotlin.test.assertTrue
+
+class CoreShutdownTests {
+    @Test(timeout = 15_000)
+    fun `owned callbacks reject self join and external callers share ordered shutdown`() =
+        runTestWithServer(Application::attachTestServices) { server, _ ->
+            runCoreTest(server.rpcClient()) {
+                run { core, _, _ -> withContext(Dispatchers.Default) {
+                    // Select the real producer context to reproduce the otherwise inaccessible
+                    // self-join boundary; no production seam exists solely for this test.
+                    val scopeField = BaseCore::class.java.getDeclaredField("coreScope")
+                    scopeField.isAccessible = true
+                    val producers = scopeField.get(core) as CoroutineScope
+                    val rejected = CompletableDeferred<Boolean>()
+                    producers.launch {
+                        rejected.complete(try {
+                            core.closeAndJoin()
+                            false
+                        } catch (_: IllegalStateException) {
+                            true
+                        })
+                    }
+                    assertTrue(withTimeout(2_000) { rejected.await() })
+                    assertTrue(requireNotNull(producers.coroutineContext[Job]).isActive)
+                    core.stop()
+                    val first = async { core.closeAndJoin() }
+                    val second = async { core.closeAndJoin() }
+                    withTimeout(5_000) { first.await(); second.await() }
+                    assertTrue(requireNotNull(producers.coroutineContext[Job]).isCompleted)
+                    core.closeAndJoin()
+                } }
+            }
+        }
+}
