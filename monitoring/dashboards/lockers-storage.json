{
  "uid": "lockers-storage",
  "title": "Lockers / Storage",
  "id": null,
  "version": 1,
  "schemaVersion": 39,
  "tags": [
    "lockers",
    "monitoring-v1",
    "storage"
  ],
  "editable": true,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "options": [],
        "refresh": 1
      },
      {
        "name": "loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "options": [],
        "refresh": 1
      },
      {
        "name": "tempo",
        "label": "Tempo",
        "type": "datasource",
        "query": "tempo",
        "current": {},
        "options": [],
        "refresh": 1
      },
      {
        "name": "service_name",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "query": "label_values(lockers_monitoring_info, service_name)",
        "definition": "label_values(lockers_monitoring_info, service_name)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "client_service_name",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "query": "label_values(lockers_monitoring_info, client_service_name)",
        "definition": "label_values(lockers_monitoring_info, client_service_name)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "query": "label_values(lockers_monitoring_info{service_name=~\"${service_name:regex}\"},environment)",
        "definition": "label_values(lockers_monitoring_info{service_name=~\"${service_name:regex}\"},environment)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "query": "label_values(lockers_monitoring_info{service_name=~\"${service_name:regex}\",environment=~\"${environment:regex}\"},job)",
        "definition": "label_values(lockers_monitoring_info{service_name=~\"${service_name:regex}\",environment=~\"${environment:regex}\"},job)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "query": "label_values(lockers_monitoring_info{job=~\"${job:regex}\",service_name=~\"${service_name:regex}\"},instance)",
        "definition": "label_values(lockers_monitoring_info{job=~\"${job:regex}\",service_name=~\"${service_name:regex}\"},instance)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Monitoring status",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Contract v1. Select your existing data sources and deployment. Component enabled=0 means disabled; missing contract or stale snapshots mean monitoring is unavailable. Idle counters remain zero. Connector data is best effort and represents reporting devices. Shared backlog counts use max across replicas; local estimates describe each replica."
      }
    },
    {
      "id": 2,
      "title": "Operations",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (store,operation,outcome) (rate(lockers_storage_operations_total{service_name=~\"${service_name:regex}\",environment=~\"${environment:regex}\",job=~\"${job:regex}\",instance=~\"${instance:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{operation}} {{outcome}} {{backend}} {{queue}} {{platform}} {{store}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No telemetry"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Storage p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,store,operation) (rate(lockers_storage_duration_seconds_bucket{service_name=~\"${service_name:regex}\",environment=~\"${environment:regex}\",job=~\"${job:regex}\",instance=~\"${instance:regex}\"}[$__rate_interval])))",
          "legendFormat": "{{operation}} {{outcome}} {{backend}} {{queue}} {{platform}} {{store}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No telemetry"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Snapshot age",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time()-max by(storage)(lockers_backlog_sample_timestamp{service_name=~\"${service_name:regex}\",environment=~\"${environment:regex}\",job=~\"${job:regex}\",instance=~\"${instance:regex}\"})",
          "legendFormat": "{{operation}} {{outcome}} {{backend}} {{queue}} {{platform}} {{store}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No telemetry"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Refresh failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (storage) (rate(lockers_backlog_refresh_failures_total{service_name=~\"${service_name:regex}\",environment=~\"${environment:regex}\",job=~\"${job:regex}\",instance=~\"${instance:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{operation}} {{outcome}} {{backend}} {{queue}} {{platform}} {{store}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No telemetry"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Component configured (0 = disabled)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(component)(lockers_monitoring_component_enabled{service_name=~\"${service_name:regex}\",environment=~\"${environment:regex}\",job=~\"${job:regex}\",instance=~\"${instance:regex}\",component=\"storage\"})",
          "legendFormat": "{{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Monitoring unavailable"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Operational events \u2014 trace IDs link to Tempo via Loki data-source settings",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"${service_name:regex}\",deployment_environment=~\"${environment:regex}\"} | json | lockers_component=\"storage\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 8,
      "title": "Recent operation traces",
      "type": "table",
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"${service_name:regex}\" && resource.deployment.environment =~ \"${environment:regex}\" && span.lockers.component = \"storage\" }",
          "limit": 20
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ],
  "links": [
    {
      "title": "Lockers Overview",
      "type": "link",
      "url": "/d/lockers-overview",
      "includeVars": true,
      "keepTime": true
    },
